# Build-time secrets for AI Chief of Staff Electron bundles.
# Copy this file to `.env.production` (gitignored) and fill in the real values.
# Read by scripts/inject-google-credentials.cjs during `npm run build`.

# Google Cloud Desktop OAuth client for the `tsai-ai-chief-of-staff` project.
# Source: https://console.cloud.google.com/apis/credentials → Desktop client → Add secret.
# Note: GitHub Secret Scanning treats any string matching the Google
# client_secret pattern as a real secret. Keep example values OBVIOUSLY fake
# (no GOCSPX- prefix here); the inject script will validate the real prefix.
ACOS_GOOGLE_CLIENT_ID=<client-id-from-json>.apps.googleusercontent.com
ACOS_GOOGLE_CLIENT_SECRET=<client-secret-from-json>
