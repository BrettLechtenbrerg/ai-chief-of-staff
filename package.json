{
  "name": "ai-chief-of-staff",
  "version": "1.0.0-beta.15",
  "description": "AI Chief of Staff — a private desktop AI agent by Total Success AI. Persistent memory, scheduled routines, browser automation, and 40+ skill integrations, powered by the Claude Agent SDK.",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "sync-version": "node scripts/sync-version.cjs",
    "prebuild": "npm run sync-version",
    "build": "tsc && tsc -p tsconfig.preload.json && node scripts/fix-esm-imports.cjs && node scripts/inject-google-credentials.cjs",
    "start": "npm run build && npm run electron",
    "dev": "node scripts/sync-version.cjs && tsc && tsc -p tsconfig.preload.json && node scripts/fix-esm-imports.cjs && npm run electron",
    "watch": "tsc -w",
    "preelectron": "node scripts/check-native.cjs",
    "electron": "electron .",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "rebuild:native": "npx electron-rebuild -f -w better-sqlite3",
    "postinstall": "npx electron-rebuild -f -w better-sqlite3",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "pretest": "node scripts/check-native-for-tests.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "dist": "npm run build && electron-builder --mac",
    "dist:local": "npm run build && electron-builder --mac --config.mac.identity=null --config.mac.hardenedRuntime=false --config.mac.notarize=false",
    "dist:signed": "BUILD_KIND=release npm run build && APPLE_KEYCHAIN_PROFILE=AC_PASSWORD electron-builder --mac && node scripts/patch-latest-mac-yml.cjs",
    "patch:latest-mac-yml": "node scripts/patch-latest-mac-yml.cjs",
    "dist:win": "BUILD_KIND=release npm run build && electron-builder --win",
    "dist:win:local": "npm run build && electron-builder --win --config.win.forceCodeSigning=false",
    "install:local": "node scripts/install-local.cjs",
    "dist:install": "npm run dist:local && npm run install:local",
    "dist:signed:install": "npm run dist:signed && npm run install:local"
  },
  "build": {
    "appId": "com.totalsuccessai.ai-chief-of-staff",
    "productName": "AI Chief of Staff",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "BrettLechtenbrerg",
      "repo": "ai-chief-of-staff"
    },
    "mac": {
      "artifactName": "AI-Chief-of-Staff-${version}-${arch}-mac.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "Brett Lechtenberg (2HQTY95NHD)",
      "notarize": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "AI Chief of Staff uses the microphone to transcribe voice notes into the chat composer, and — when you enable Voice mode — for a hands-free live conversation with your assistant."
      }
    },
    "win": {
      "artifactName": "AI-Chief-of-Staff-${version}-${arch}-win.${ext}",
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AI-Chief-of-Staff-${version}-${arch}-setup.${ext}",
      "shortcutName": "AI Chief of Staff",
      "uninstallDisplayName": "AI Chief of Staff"
    },
    "dmg": {
      "artifactName": "AI-Chief-of-Staff-${version}-${arch}.${ext}",
      "background": "build/background.png",
      "icon": "build/icon.icns",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "asar": false,
    "afterPack": "./build/afterPack.cjs",
    "afterAllArtifactBuild": "./build/afterAllArtifactBuild.cjs",
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": ".claude/",
        "to": "app/.claude/"
      },
      {
        "from": "vendor/",
        "to": "vendor/",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/__pycache__/**",
          "!**/.DS_Store"
        ]
      }
    ]
  },
  "author": "Total Success AI — Brett Lechtenberg",
  "license": "MIT",
  "overrides": {
    "better-sqlite3": "^12.6.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@kenkaiiii/gg-agent": "4.3.151",
    "@kenkaiiii/gg-ai": "4.3.151",
    "@kenkaiiii/ggcoder": "^4.3.140",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.6.2",
    "city-timezones": "^1.3.3",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.3",
    "grammy": "^1.41.1",
    "mammoth": "^1.12.0",
    "officeparser": "^6.0.4",
    "openai": "^6.27.0",
    "pdfjs-dist": "^5.7.284",
    "puppeteer-core": "^24.43.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.4.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.3",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
